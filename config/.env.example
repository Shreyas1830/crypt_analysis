# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real `.env` file.

# CoinMarketCap sandbox key (a public demo key ships as a default in settings.py,
# but supply your own from https://pro.coinmarketcap.com/signup for the sandbox)
CMC_API_KEY=your_sandbox_key_here
CMC_TOP_N=100
CMC_CONVERT=USD

# Database
DB_ENGINE=sqlite
POSTGRES_URI=postgresql+psycopg2://user:password@localhost:5432/crypto_analytics

# Scheduler
FETCH_INTERVAL_MINUTES=30

# Logging
LOG_LEVEL=INFO

# Feature engineering / anomaly thresholds
ZSCORE_THRESHOLD=3.0
IQR_MULTIPLIER=1.5
ISOLATION_FOREST_CONTAMINATION=0.03
